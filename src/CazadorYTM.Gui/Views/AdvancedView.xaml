<UserControl x:Class="CazadorYTM.Gui.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="{loc:Loc AdvPanelName}"
             KeyboardNavigation.TabNavigation="Cycle">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24" MaxWidth="920" HorizontalAlignment="Stretch">

            <!-- Title -->
            <TextBlock Text="{loc:Loc AdvTitle}" FontSize="22" FontWeight="Bold" 
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,0,16"/>

            <!-- Section 1: File Verifier -->
            <GroupBox Header="{loc:Loc AdvVerifierHeader}" Margin="0,0,0,16"
                      AutomationProperties.Name="{loc:Loc AdvVerifierGroupHint}">
                <StackPanel Margin="12">
                    <Label x:Name="LblVerifyFolder" Target="{Binding ElementName=TxtVerifyFolder}" 
                           Content="{loc:Loc AdvVerifyFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtVerifyFolder" Grid.Column="0" 
                                 Text="{Binding VerifyFolderPath, UpdateSourceTrigger=PropertyChanged}" 
                                 ui:ControlHelper.PlaceholderText="{loc:Loc AdvVerifyFolderPlaceholder}" 
                                 VerticalContentAlignment="Center" Height="36" Margin="0,0,10,0"
                                 AutomationProperties.Name="{loc:Loc AdvVerifyFolderHint}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblVerifyFolder}"/>
                        
                        <Button Grid.Column="1" Content="{loc:Loc BtnBrowse}" Width="110" Height="36" 
                                Command="{Binding SelectVerifyFolderCommand}" Margin="0,0,10,0"
                                AutomationProperties.Name="{loc:Loc AdvBtnBrowseHint}"/>
                        
                        <Button Grid.Column="2" Content="{loc:Loc AdvBtnVerify}" Style="{DynamicResource AccentButtonStyle}" 
                                Width="160" Height="36" Command="{Binding StartVerificationCommand}"
                                AutomationProperties.Name="{loc:Loc AdvBtnVerifyHint}"/>
                    </Grid>

                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Content="{loc:Loc AdvDeepVerify}" 
                                  IsChecked="{Binding IsDeepVerify}" Margin="0,0,20,6" Height="28"
                                  AutomationProperties.Name="{loc:Loc AdvDeepVerifyHint}"/>
                        <Button Content="{loc:Loc AdvBtnOpenReport}" Height="32" Padding="12,0"
                                Command="{Binding OpenReportCommand}"
                                AutomationProperties.Name="{loc:Loc AdvBtnOpenReportHint}"/>
                    </WrapPanel>

                    <ProgressBar Value="{Binding VerifyProgress}" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,6"
                                 AutomationProperties.Name="{loc:Loc AdvVerifyProgressHint}"
                                 AutomationProperties.LiveSetting="Polite"/>
                    
                    <TextBlock Text="{Binding VerifyStatus}" FontSize="12" 
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,4"
                               AutomationProperties.Name="{loc:Loc AdvVerifyStatusHint}"
                               AutomationProperties.LiveSetting="Polite"/>
                    
                    <TextBlock Text="{Binding VerifySummary}" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}" Margin="0,0,0,10"
                               AutomationProperties.Name="{loc:Loc AdvVerifySummaryHint}"
                               AutomationProperties.LiveSetting="Polite"/>

                    <!-- Results DataGrid -->
                    <DataGrid ItemsSource="{Binding VerificationResults}" AutoGenerateColumns="False" 
                              Height="180" IsReadOnly="True" HeadersVisibility="Column"
                              BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                              AutomationProperties.Name="{loc:Loc AdvResultsGridHint}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc ColStatus}" Binding="{Binding Estado}" Width="110"/>
                            <DataGridTextColumn Header="{loc:Loc AdvColFile}" Binding="{Binding Nombre}" Width="260"/>
                            <DataGridTextColumn Header="{loc:Loc AdvColFullPath}" Binding="{Binding Ruta}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>

            <!-- Section 2: Binary Updater -->
            <GroupBox Header="{loc:Loc AdvUpdaterHeader}" Margin="0,0,0,16"
                      AutomationProperties.Name="{loc:Loc AdvUpdaterGroupHint}">
                <StackPanel Margin="12">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding UpdateStatus}" VerticalAlignment="Center" FontWeight="Medium"
                                   AutomationProperties.Name="{loc:Loc AdvUpdaterStatusHint}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button Grid.Column="1" Content="{loc:Loc AdvBtnCheckUpdates}" Width="220" Height="36" 
                                Command="{Binding CheckUpdatesCommand}"
                                AutomationProperties.Name="{loc:Loc AdvBtnCheckUpdatesHint}"/>
                    </Grid>
                    <ProgressBar Value="{Binding UpdateProgress}" Minimum="0" Maximum="100" Height="8"
                                 AutomationProperties.Name="{loc:Loc AdvUpdaterProgressHint}"
                                 AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </GroupBox>

            <!-- Section 3: Proxy Configuration -->
            <GroupBox Header="{loc:Loc AdvProxyHeader}" Margin="0,0,0,10"
                      AutomationProperties.Name="{loc:Loc AdvProxyGroupHint}">
                <StackPanel Margin="12">
                    <Label x:Name="LblProxy" Target="{Binding ElementName=TxtProxy}" 
                           Content="{loc:Loc AdvProxyLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtProxy" Grid.Column="0" 
                                 Text="{Binding ProxyText, UpdateSourceTrigger=PropertyChanged}" 
                                 ui:ControlHelper.PlaceholderText="{loc:Loc AdvProxyPlaceholder}" 
                                 VerticalContentAlignment="Center" Height="36" Margin="0,0,10,0"
                                 AutomationProperties.Name="{loc:Loc AdvProxyHint}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblProxy}"/>
                        <Button Grid.Column="1" Content="{loc:Loc AdvBtnSaveProxy}" Width="140" Height="36" 
                                Command="{Binding SaveProxyCommand}"
                                AutomationProperties.Name="{loc:Loc AdvBtnSaveProxyHint}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
