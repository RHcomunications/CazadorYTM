<Window x:Class="CazadorYTM.Gui.Views.CookiesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
        Title="{loc:Loc CookiesWindowTitle}"
        Height="540" Width="680"
        MinHeight="460" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ui:WindowHelper.UseModernWindowStyle="True"
        AutomationProperties.Name="{loc:Loc CookiesPanelName}"
        AutomationProperties.HelpText="{loc:Loc CookiesHelpText}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Status Banner -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,10" CornerRadius="6"
                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusSummary}" TextWrapping="Wrap"
                           VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{loc:Loc CookiesStatusHint}"/>
                <Button Grid.Column="1" Content="{loc:Loc OpenFolder}" Command="{Binding OpenCookiesFolderCommand}"
                        Height="28" Padding="10,0" Margin="10,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Loc CookiesBtnOpenFolderHint}"/>
            </Grid>
        </Border>

        <!-- Main Tab Control for the 3 Methods -->
        <TabControl Grid.Row="1" Margin="0,0,0,14">

            <!-- Vía 1: Extracción Automática desde Navegador -->
            <TabItem Header="{loc:Loc CookiesTabExtract}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Margin="6">
                        <TextBlock Text="{loc:Loc CookiesExtractTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Loc CookiesExtractDesc}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,16"/>

                        <Label x:Name="LblBrowserSelect" Target="{Binding ElementName=CmbBrowserSelect}" Content="{loc:Loc CookiesBrowserLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbBrowserSelect" ItemsSource="{Binding Browsers}" SelectedItem="{Binding SelectedBrowser}" Height="36" Margin="0,0,0,14" HorizontalAlignment="Stretch"
                                  AutomationProperties.LabeledBy="{Binding ElementName=LblBrowserSelect}"/>

                        <CheckBox Content="{loc:Loc CookiesSaveJson}" IsChecked="{Binding SaveAsJson}" Margin="0,0,0,16"/>

                        <Button Content="{loc:Loc CookiesBtnExtract}" Command="{Binding ExtractFromBrowserCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Height="38" Padding="20,0" HorizontalAlignment="Left" Margin="0,0,0,12"
                                IsEnabled="{Binding IsExtracting, Converter={StaticResource InverseBooleanConverter}}"
                                AutomationProperties.Name="{loc:Loc CookiesBtnExtractHint}"/>

                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding IsExtracting, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding AutoExtractStatus}" TextWrapping="Wrap" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Vía 2: Asistente con Extensión y robots.txt -->
            <TabItem Header="{loc:Loc CookiesTabAssistant}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Margin="6">
                        <TextBlock Text="{loc:Loc CookiesAssistantTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc CookiesAssistantDesc}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,12"/>

                        <!-- Step by Step -->
                        <Border Padding="12" CornerRadius="4" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc CookiesStepsHeader}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{loc:Loc CookiesStep1}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{loc:Loc CookiesStep2}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{loc:Loc CookiesStep3}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{loc:Loc CookiesStep4}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="{loc:Loc CookiesBtnRobots}" Command="{Binding OpenRobotsUrlCommand}" Height="32" Padding="12,0" Margin="0,0,8,6"
                                    AutomationProperties.Name="{loc:Loc CookiesBtnRobotsHint}"/>
                            <Button Content="{loc:Loc CookiesBtnPaste}" Command="{Binding PasteClipboardCommand}" Height="32" Padding="12,0" Margin="0,0,8,6"
                                    AutomationProperties.Name="{loc:Loc CookiesBtnPasteHint}"/>
                            <Button Content="{loc:Loc CookiesBtnClearText}" Command="{Binding ClearManualTextCommand}" Height="32" Padding="12,0" Margin="0,0,8,6"/>
                        </WrapPanel>

                        <TextBox Text="{Binding ManualCookiesText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="110" FontFamily="Consolas" FontSize="11" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 ui:ControlHelper.PlaceholderText="{loc:Loc CookiesManualPlaceholder}"
                                 AutomationProperties.Name="{loc:Loc CookiesManualHint}" Margin="0,0,0,10"/>

                        <Button Content="{loc:Loc CookiesBtnSaveManual}" Command="{Binding SaveManualCookiesCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Height="36" Padding="18,0" HorizontalAlignment="Left" Margin="0,0,0,8"
                                AutomationProperties.Name="{loc:Loc CookiesBtnSaveManualHint}"/>

                        <TextBlock Text="{Binding ManualStatus}" TextWrapping="Wrap" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Vía 3: Exportar / Importar Archivo -->
            <TabItem Header="{loc:Loc CookiesTabFile}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Margin="6">
                        <TextBlock Text="{loc:Loc CookiesFileTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Loc CookiesFileDesc}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,16"/>

                        <!-- Export Group -->
                        <GroupBox Header="{loc:Loc CookiesExportGroup}" Margin="0,0,0,14">
                            <StackPanel Margin="10">
                                <TextBlock Text="{loc:Loc CookiesExportDesc}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Content="{loc:Loc CookiesBtnExport}" Command="{Binding ExportCookiesCommand}" Height="36" Padding="16,0" HorizontalAlignment="Left"
                                        IsEnabled="{Binding HasActiveCookies}"
                                        AutomationProperties.Name="{loc:Loc CookiesBtnExportHint}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Import Group -->
                        <GroupBox Header="{loc:Loc CookiesImportGroup}" Margin="0,0,0,14">
                            <StackPanel Margin="10">
                                <TextBlock Text="{loc:Loc CookiesImportDesc}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Content="{loc:Loc CookiesBtnImport}" Command="{Binding ImportCookiesCommand}" Height="36" Padding="16,0" HorizontalAlignment="Left"
                                        AutomationProperties.Name="{loc:Loc CookiesBtnImportHint}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Delete button -->
                        <Button Content="{loc:Loc CookiesBtnDelete}" Command="{Binding DeleteCookiesCommand}" Height="34" Padding="14,0" HorizontalAlignment="Left"
                                IsEnabled="{Binding HasActiveCookies}"
                                AutomationProperties.Name="{loc:Loc CookiesBtnDeleteHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{loc:Loc BtnExportLogs}" Command="{Binding ExportLogsCommand}" Height="36" Padding="12,0" Margin="0,0,8,0"
                        AutomationProperties.Name="{loc:Loc BtnExportLogsHint}"/>
                <Button Content="{loc:Loc BtnSupportTelegram}" Command="{Binding ContactSupportCommand}" Height="36" Padding="12,0"
                        AutomationProperties.Name="{loc:Loc BtnSupportTelegramHint}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Close}" IsCancel="True" Command="{Binding CloseCommand}" Width="100" Height="36"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
