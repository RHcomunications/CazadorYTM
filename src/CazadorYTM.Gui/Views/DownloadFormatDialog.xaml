<Window x:Class="CazadorYTM.Gui.Views.DownloadFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
        Title="{loc:Loc DownloadFormatWindowTitle}"
        Height="440" Width="560"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ui:WindowHelper.UseModernWindowStyle="True"
        AutomationProperties.Name="{loc:Loc DownloadFormatWindowTitle}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,18"/>

        <RadioButton x:Name="RbDefault" Grid.Row="1" GroupName="FormatMode"
                     IsChecked="True" Margin="0,0,0,12"
                     Checked="OnOptionChanged"/>

        <RadioButton x:Name="RbCustom" Grid.Row="2" GroupName="FormatMode"
                     Content="{loc:Loc DownloadFormatCustom}"
                     Checked="OnOptionChanged"/>

        <Grid x:Name="CustomPanel" Grid.Row="3" Margin="28,10,0,0" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Label x:Name="LblFormat" Target="{Binding ElementName=CmbFormat}"
                       Content="{loc:Loc FormatLabel}" FontWeight="SemiBold" Padding="0" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbFormat" Height="36"
                          AutomationProperties.LabeledBy="{Binding ElementName=LblFormat}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Label x:Name="LblBitrate" Target="{Binding ElementName=CmbBitrate}"
                       Content="{loc:Loc QualityLabel}" FontWeight="SemiBold" Padding="0" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbBitrate" Height="36"
                          AutomationProperties.LabeledBy="{Binding ElementName=LblBitrate}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" Text="{loc:Loc DownloadFormatNote}"
                   TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,18,0,0"
                   FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:Loc DownloadFormatBtnDownload}" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="OnDownloadClick" Height="34" Padding="18,0" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc DownloadFormatBtnCancel}" IsCancel="True"
                    Height="34" Padding="18,0"/>
        </StackPanel>
    </Grid>
</Window>
