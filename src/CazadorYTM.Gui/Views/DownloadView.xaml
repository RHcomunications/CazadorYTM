<UserControl x:Class="CazadorYTM.Gui.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="{loc:Loc TabDownloads}"
             KeyboardNavigation.TabNavigation="Cycle">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24" MaxWidth="920" HorizontalAlignment="Stretch">

            <!-- Section 1: Title and Main Input -->
            <TextBlock Text="{loc:Loc DownloadTitle}" FontSize="22" FontWeight="Bold" 
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,0,4"/>
            <Label x:Name="LblInput" Target="{Binding ElementName=TxtInput}" 
                   Content="{loc:Loc SearchPlaceholder}" 
                   FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,6"/>

            <!-- Section 1: Search / Input Box & Primary Actions -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtInput" Grid.Column="0" 
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Height="40" VerticalContentAlignment="Center"
                         ui:ControlHelper.PlaceholderText="{loc:Loc SearchPlaceholder}" 
                         AutomationProperties.LabeledBy="{Binding ElementName=LblInput}"
                         AutomationProperties.Name="Caja de búsqueda y descarga"
                         AutomationProperties.HelpText="Escriba el nombre de la canción o pegue un enlace de YouTube, SoundCloud, TikTok, etc. y pulse Enter"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitInputCommand}"/>
                        <KeyBinding Key="Return" Command="{Binding SubmitInputCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1" Content="{loc:Loc BtnSearch}" Height="40" Width="160" Margin="0,0,10,0"
                        Command="{Binding SearchAndAnalyzeCommand}"/>

                <Button Grid.Column="2" Content="{loc:Loc BtnLoadList}" Height="40" Width="140"
                        Command="{Binding LoadListFileCommand}"/>
            </Grid>

            <!-- Section 2: Destination Folder -->
            <GroupBox Header="{loc:Loc DestFolderHeader}" Margin="0,0,0,16">
                <Grid Margin="12,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="13" Height="36" VerticalContentAlignment="Center" Margin="0,0,10,0"
                             AutomationProperties.Name="{loc:Loc DestFolderHeader}"/>
                    <Button Grid.Column="1" Content="{loc:Loc BtnBrowse}" Height="36" Width="120"
                            Command="{Binding SelectDestinationFolderCommand}"/>
                </Grid>
            </GroupBox>

            <!-- Section 3: Conversion & Performance Options -->
            <GroupBox Header="{loc:Loc OptionsHeader}" Margin="0,0,0,16">
                <StackPanel Margin="12,10,12,10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Source -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label x:Name="LblSearchSource" Target="{Binding ElementName=CmbSearchSource}" Content="{loc:Loc SourceLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbSearchSource" ItemsSource="{Binding SearchSources}" SelectedItem="{Binding SelectedSearchSource}" 
                                      HorizontalAlignment="Stretch" Height="36"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LblSearchSource}"/>
                        </StackPanel>

                        <!-- Format -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <Label x:Name="LblFormat" Target="{Binding ElementName=CmbFormat}" Content="{loc:Loc FormatLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbFormat" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" 
                                      HorizontalAlignment="Stretch" Height="36"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LblFormat}"/>
                        </StackPanel>

                        <!-- Bitrate -->
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <Label x:Name="LblBitrate" Target="{Binding ElementName=CmbBitrate}" Content="{loc:Loc QualityLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbBitrate" ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedBitrate}" 
                                      HorizontalAlignment="Stretch" Height="36"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LblBitrate}"/>
                        </StackPanel>

                        <!-- Concurrency -->
                        <StackPanel Grid.Column="3">
                            <Label x:Name="LblConcurrent" Target="{Binding ElementName=CmbConcurrent}" Content="{loc:Loc ThreadsLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbConcurrent" ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding SelectedConcurrent}" 
                                      HorizontalAlignment="Stretch" Height="36"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LblConcurrent}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Checkboxes -->
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="{loc:Loc SponsorBlockOpt}" IsChecked="{Binding IsSponsorBlock}" Margin="0,0,16,6"/>
                        <CheckBox Content="{loc:Loc NormalizeOpt}" IsChecked="{Binding IsNormalize}" Margin="0,0,16,6"/>
                        <CheckBox Content="{loc:Loc EmbedLyricsOpt}" IsChecked="{Binding IsEmbedLyrics}" Margin="0,0,16,6"/>
                        <CheckBox Content="{loc:Loc EnumerateOpt}" IsChecked="{Binding IsEnumerate}" Margin="0,0,16,6"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- Section 4: Actions & Progress -->
            <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="14" 
                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding ProgressDetail}" FontSize="12" 
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="{loc:Loc BtnCancel}" Width="130" Height="42" Margin="0,0,10,0"
                        Command="{Binding CancelDownloadCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button Grid.Column="2" Content="{loc:Loc BtnDownload}" Style="{DynamicResource AccentButtonStyle}" 
                        Width="180" Height="42"
                        Command="{Binding StartDownloadCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            </Grid>

            <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="14" 
                         AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
