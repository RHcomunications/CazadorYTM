<UserControl x:Class="CazadorYTM.Gui.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
             AutomationProperties.Name="{loc:Loc TabLibrary}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshHistoryCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar and Count -->
        <!-- Search & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtSearchHistory" Grid.Column="0" 
                     Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="13" Height="36" VerticalContentAlignment="Center"
                     ui:ControlHelper.PlaceholderText="{loc:Loc LibraryFilterPlaceholder}"
                     AutomationProperties.Name="{loc:Loc LibraryFilterPlaceholder}"
                     PreviewKeyDown="TxtSearchHistory_PreviewKeyDown"
                     Margin="0,0,8,0"/>

            <Button Grid.Column="1" Content="{loc:Loc HistoryBtnPlayAll}" Command="{Binding PlayAllCommand}" Height="36" Padding="12,0" Margin="0,0,8,0"
                    ToolTip="{loc:Loc HistoryBtnPlayAllToolTip}"
                    AutomationProperties.Name="{loc:Loc HistoryBtnPlayAllHint}"/>

            <Button Grid.Column="2" Content="{loc:Loc HistoryBtnExportM3u8}" Command="{Binding ExportPlaylistM3U8Command}" Height="36" Padding="12,0" Margin="0,0,8,0"
                    ToolTip="{loc:Loc HistoryBtnExportM3u8ToolTip}"
                    AutomationProperties.Name="{loc:Loc HistoryBtnExportM3u8Hint}"/>

            <Button Grid.Column="3" Content="{loc:Loc HistoryBtnCleanMissing}" Command="{Binding CleanMissingEntriesCommand}" Height="36" Padding="12,0" Margin="0,0,8,0"
                    ToolTip="{loc:Loc HistoryBtnCleanMissingToolTip}"
                    AutomationProperties.Name="{loc:Loc HistoryBtnCleanMissingHint}"/>

            <Button Grid.Column="4" Content="{loc:Loc BtnRefresh}" Command="{Binding RefreshHistoryCommand}" Height="36" Width="100"
                    AutomationProperties.Name="{loc:Loc BtnRefresh}"/>
        </Grid>

        <!-- History ListBox: FullRow Navigation with Single Tab Jump Out and UI Virtualization -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Column Headers Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}"
                    BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="14,8,18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc ColTitle}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Grid.Column="1" Text="{loc:Loc ColFormat}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Grid.Column="2" Text="{loc:Loc ColStatus}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Grid.Column="3" Text="{loc:Loc ColDate}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </Grid>
            </Border>

            <!-- Accessible Virtualized ListBox -->
            <ListBox x:Name="ListHistory" Grid.Row="1"
                     ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry}"
                     SelectionMode="Single" Focusable="True"
                     KeyboardNavigation.TabNavigation="Once"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     VirtualizingPanel.IsContainerVirtualizable="True"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="1" BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}"
                     Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                     ui:ControlHelper.CornerRadius="0,0,6,6"
                     AutomationProperties.Name="{loc:Loc TabLibrary}"
                     MouseDoubleClick="ListHistory_MouseDoubleClick"
                     PreviewKeyDown="ListHistory_PreviewKeyDown"
                     SelectionChanged="ListHistory_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="Padding" Value="10,4,14,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayText}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Format}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc BtnPlay}" InputGestureText="Enter" Command="{Binding PlaySelectedCommand}" />
                        <MenuItem Header="{loc:Loc HistoryMenuRetryDownload}" Command="{Binding RetryDownloadCommand}" />
                        <MenuItem Header="{loc:Loc OpenFolder}" Command="{Binding OpenContainingFolderCommand}" />
                        <MenuItem Header="{loc:Loc CopyLink}" Command="{Binding CopyUrlCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc DeleteFromHistory}" InputGestureText="Supr / Del" Command="{Binding DeleteSelectedCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{loc:Loc BtnPlay}" Style="{DynamicResource AccentButtonStyle}" Command="{Binding PlaySelectedCommand}" Height="36" Width="130" Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Loc BtnPlay}"/>
            <Button Grid.Column="1" Content="{loc:Loc OpenFolder}" Command="{Binding OpenContainingFolderCommand}" Height="36" Width="140" Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Loc OpenFolder}"/>
            <Button Grid.Column="2" Content="{loc:Loc CopyLink}" Command="{Binding CopyUrlCommand}" Height="36" Width="130" Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Loc CopyLink}"/>

            <Button Grid.Column="4" Content="{loc:Loc ClearHistory}" Command="{Binding ClearAllCommand}" Height="36" Width="150"
                    AutomationProperties.Name="{loc:Loc ClearHistory}"/>
        </Grid>
    </Grid>
</UserControl>
