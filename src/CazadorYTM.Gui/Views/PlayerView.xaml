<UserControl x:Class="CazadorYTM.Gui.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
             xmlns:acc="clr-namespace:CazadorYTM.Gui.Accessibility"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="{loc:Loc PlayerPanelName}"
             KeyboardNavigation.TabNavigation="Cycle">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="Space" Command="{Binding PlayPauseCommand}"/>
        <KeyBinding Key="MediaPlayPause" Command="{Binding PlayPauseCommand}"/>
        <KeyBinding Modifiers="Shift" Key="Left" Command="{Binding SeekRelativeCommand}" CommandParameter="-5"/>
        <KeyBinding Modifiers="Shift" Key="Right" Command="{Binding SeekRelativeCommand}" CommandParameter="5"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="Left" Command="{Binding SeekRelativeCommand}" CommandParameter="-30"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="Right" Command="{Binding SeekRelativeCommand}" CommandParameter="30"/>
        <KeyBinding Modifiers="Ctrl" Key="Up" Command="{Binding VolumeUpCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Down" Command="{Binding VolumeDownCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="Down" Command="{Binding MuteToggleCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="Up" Command="{Binding MaxVolumeCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding StopCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="L" Command="{Binding ToggleLyricsCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding CycleSleepTimerCommand}"/>
        <KeyBinding Key="OemOpenBrackets" Command="{Binding SpeedDownCommand}"/>
        <KeyBinding Key="OemCloseBrackets" Command="{Binding SpeedUpCommand}"/>
        <KeyBinding Key="OemPipe" Command="{Binding ResetSpeedCommand}"/>
        <KeyBinding Key="Home" Command="{Binding SeekToStartCommand}"/>
        <KeyBinding Key="End" Command="{Binding SeekToEndCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="32">
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}" 
                BorderThickness="1" CornerRadius="12" Padding="32" MaxWidth="720" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch">

                <!-- Header / Track Details -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="{Binding TrackTitle}" FontSize="22" FontWeight="Bold" 
                               HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,0,0,6"
                               AutomationProperties.Name="{Binding TrackTitle}"/>
                    <TextBlock Text="{Binding TrackArtist}" FontSize="15" 
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center"
                               AutomationProperties.Name="{Binding TrackArtist}"/>
                </StackPanel>

                <!-- Timeline Slider & Time Labels -->
                <StackPanel Margin="0,0,0,24">
                    <Label x:Name="LblSeek" Target="{Binding ElementName=SldPosition}" Content="{loc:Loc TrackPositionLabel}" FontSize="12" Margin="0,0,0,4"/>
                    <Slider x:Name="SldPosition" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="False" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                            SmallChange="5" LargeChange="30"
                            AutomationProperties.Name="{Binding AccessiblePositionText}"
                            AutomationProperties.HelpText="{loc:Loc PlayerSeekHelp}"/>
                    <Grid>
                        <TextBlock Text="{Binding CurrentPositionText}" HorizontalAlignment="Left" FontSize="12" 
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="{Binding DurationText}" HorizontalAlignment="Right" FontSize="12" 
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Control Buttons -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Open File -->
                    <Button Grid.Column="0" Content="{loc:Loc BtnOpenAudioFile}" Command="{Binding OpenFileCommand}" 
                            HorizontalAlignment="Left" Width="130" Height="40"
                            AutomationProperties.Name="{loc:Loc PlayerOpenLocalAudio}"
                            AutomationProperties.HelpText="{loc:Loc PlayerOpenLocalAudioHelp}"/>

                    <!-- Playback Controls (Shuffle, Prev, Play/Pause, Next, Repeat) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Shuffle -->
                        <Button Content="🔀" Command="{Binding ToggleShuffleCommand}" Width="44" Height="40" Margin="0,0,6,0"
                                ToolTip="{loc:Loc PlayerShuffleName}"
                                AutomationProperties.Name="{loc:Loc PlayerShuffleName}"
                                AutomationProperties.HelpText="{loc:Loc PlayerShuffleHelp}"/>

                        <!-- Previous -->
                        <Button Content="⏮" Command="{Binding PlayPreviousCommand}" Width="48" Height="40" Margin="0,0,6,0"
                                IsEnabled="{Binding HasPrevious}"
                                ToolTip="{loc:Loc PlayerPrevTrack}"
                                AutomationProperties.Name="{loc:Loc PlayerPrevTrack}"
                                AutomationProperties.HelpText="{loc:Loc PlayerPrevTrackHelp}"/>

                        <!-- Play/Pause -->
                        <Button Content="{loc:Loc BtnPlayPause}" Style="{DynamicResource AccentButtonStyle}" 
                                Command="{Binding PlayPauseCommand}" Width="150" Height="40" Margin="0,0,6,0"
                                AutomationProperties.Name="{loc:Loc BtnPlayPause}"
                                AutomationProperties.HelpText="{loc:Loc PlayerPlayPauseHelp}"/>

                        <!-- Next -->
                        <Button Content="⏭" Command="{Binding PlayNextCommand}" Width="48" Height="40" Margin="0,0,6,0"
                                IsEnabled="{Binding HasNext}"
                                ToolTip="{loc:Loc PlayerNextTrack}"
                                AutomationProperties.Name="{loc:Loc PlayerNextTrack}"
                                AutomationProperties.HelpText="{loc:Loc PlayerNextTrackHelp}"/>

                        <!-- Repeat -->
                        <Button Content="🔁" Command="{Binding ToggleRepeatCommand}" Width="44" Height="40" Margin="0,0,6,0"
                                ToolTip="{Binding RepeatModeText}"
                                AutomationProperties.Name="{Binding RepeatModeText}"
                                AutomationProperties.HelpText="{loc:Loc PlayerRepeatHelp}"/>

                        <!-- Stop -->
                        <Button Content="{loc:Loc BtnStop}" Command="{Binding StopCommand}" Width="80" Height="40"
                                AutomationProperties.Name="{loc:Loc PlayerStopTrack}"
                                AutomationProperties.HelpText="{loc:Loc PlayerStopTrackHelp}"/>
                    </StackPanel>

                    <!-- Volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Label x:Name="LblVol" Target="{Binding ElementName=SldVolume}" Content="{loc:Loc VolumeLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider x:Name="SldVolume" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" Width="100" VerticalAlignment="Center"
                                SmallChange="0.05" LargeChange="0.1"
                                AutomationProperties.Name="{Binding AccessibleVolumeText}"
                                AutomationProperties.HelpText="{loc:Loc PlayerVolumeHelp}"/>
                    </StackPanel>
                </Grid>

                <!-- Auxiliary Controls Bar: Speed, Sleep Timer, Lyrics Toggle -->
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- Playback Speed Control -->
                        <Label Target="{Binding ElementName=BtnSpeed}" Content="{loc:Loc PlayerSpeed}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnSpeed" Content="{Binding SpeedRatioText}" Command="{Binding CycleSpeedCommand}"
                                Height="32" Padding="12,0" Margin="0,0,10,0"
                                ToolTip="{loc:Loc PlayerSpeedToolTip}"
                                AutomationProperties.Name="{loc:Loc PlayerSpeedAutomationName}"
                                AutomationProperties.HelpText="{loc:Loc PlayerSpeedHelp}"/>

                        <!-- Sleep Timer Control -->
                        <Button x:Name="BtnSleepTimer" Content="{Binding SleepTimerText}" Command="{Binding CycleSleepTimerCommand}"
                                Height="32" Padding="12,0"
                                ToolTip="{Binding SleepTimerText}"
                                AutomationProperties.Name="{Binding SleepTimerText}"
                                AutomationProperties.HelpText="{loc:Loc PlayerSleepTimerHelp}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Lyrics Toggle Button -->
                        <Button x:Name="BtnLyricsToggle" Content="{loc:Loc BtnLyrics}" Command="{Binding ToggleLyricsCommand}"
                                Height="32" Padding="14,0"
                                ToolTip="{loc:Loc PlayerLyricsToggleToolTip}"
                                AutomationProperties.Name="{loc:Loc PlayerLyricsToggleToolTip}"
                                AutomationProperties.HelpText="{loc:Loc PlayerLyricsToggleHelp}"/>
                    </StackPanel>
                </Grid>

                <!-- Queue Status Indicator -->
                <TextBlock Text="{Binding QueueStatusText}" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           AutomationProperties.Name="{Binding QueueStatusText}"
                           AutomationProperties.LiveSetting="Polite"/>

                <!-- Synchronized Lyrics Panel (Modo Karaoke) -->
                <Border x:Name="LyricsCard" 
                        Visibility="{Binding IsLyricsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc PlayerLyricsPanelTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding LyricsStatusText}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄" Command="{Binding RefreshLyricsCommand}" Width="32" Height="30" Margin="0,0,6,0"
                                        ToolTip="{loc:Loc PlayerLyricsRefreshToolTip}"
                                        AutomationProperties.Name="{loc:Loc PlayerLyricsRefreshToolTip}"
                                        AutomationProperties.HelpText="{loc:Loc PlayerLyricsRefreshHelp}"/>
                                <Button Content="✕" Command="{Binding ToggleLyricsCommand}" Width="32" Height="30"
                                        ToolTip="{loc:Loc PlayerLyricsCloseToolTip}"
                                        AutomationProperties.Name="{loc:Loc PlayerLyricsCloseToolTip}"
                                        AutomationProperties.HelpText="{loc:Loc PlayerLyricsCloseHelp}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Lyrics ListBox with Karaoke active highlighting -->
                        <ListBox x:Name="ListLyrics" Grid.Row="1"
                                 ItemsSource="{Binding Lyrics}"
                                 SelectedIndex="{Binding CurrentLyricIndex, Mode=OneWay}"
                                 MaxHeight="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 AutomationProperties.Name="{loc:Loc PlayerLyricsPanelTitle}"
                                 AutomationProperties.HelpText="{loc:Loc PlayerLyricsListHelp}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" Margin="4,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <TextBlock x:Name="TrackLiveAnnouncer"
                           Text="{Binding TrackAnnouncement}"
                           AutomationProperties.LiveSetting="Polite"
                           acc:LiveRegion.Announce="{Binding TrackAnnouncement}"
                           Height="1" Width="1" Opacity="0.01" Focusable="False"/>

                <!-- Live Region for assertive volume updates during manipulation -->
                <TextBlock x:Name="VolumeLiveAnnouncer" 
                           Text="{Binding VolumeAnnouncement}" 
                           AutomationProperties.LiveSetting="Assertive"
                           acc:LiveRegion.Announce="{Binding VolumeAnnouncement}"
                           Height="1" Width="1" Opacity="0.01" Focusable="False"/>

                <!-- Live Region for polite sleep timer announcements -->
                <TextBlock x:Name="SleepTimerLiveAnnouncer"
                           Text="{Binding SleepTimerAnnouncement}"
                           AutomationProperties.LiveSetting="Polite"
                           acc:LiveRegion.Announce="{Binding SleepTimerAnnouncement}"
                           Height="1" Width="1" Opacity="0.01" Focusable="False"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
