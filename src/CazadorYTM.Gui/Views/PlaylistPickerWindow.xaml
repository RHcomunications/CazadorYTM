<Window x:Class="CazadorYTM.Gui.Views.PlaylistPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
        Title="{loc:Loc AddToPlaylistWindowTitle}"
        Height="520" Width="620"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ui:WindowHelper.UseModernWindowStyle="True"
        AutomationProperties.Name="{loc:Loc AddToPlaylistWindowTitle}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Label x:Name="LblPlaylists" Grid.Row="1" Target="{Binding ElementName=LstPlaylists}"
               Content="{loc:Loc AddToPlaylistListLabel}" FontWeight="SemiBold" Margin="0,0,0,6"
               Padding="0"/>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <ListBox x:Name="LstPlaylists" DisplayMemberPath="Title"
                     SelectionChanged="OnPlaylistSelectionChanged"
                     MouseDoubleClick="OnPlaylistDoubleClick"
                     AutomationProperties.LabeledBy="{Binding ElementName=LblPlaylists}"/>
            <TextBlock x:Name="EmptyText" Text="{loc:Loc AddToPlaylistEmpty}"
                       Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="20"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Grid>

        <Label x:Name="LblNew" Grid.Row="3" Target="{Binding ElementName=TxtNewPlaylist}"
               Content="{loc:Loc AddToPlaylistNewLabel}" FontWeight="SemiBold" Margin="0,0,0,6"
               Padding="0"/>

        <TextBox x:Name="TxtNewPlaylist" Grid.Row="4" Height="36"
                 AutomationProperties.LabeledBy="{Binding ElementName=LblNew}"
                 AutomationProperties.HelpText="{loc:Loc AddToPlaylistNewPlaceholder}"
                 TextChanged="OnNewTitleChanged"
                 KeyDown="OnNewTitleKeyDown"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnCreate" Content="{loc:Loc AddToPlaylistBtnCreate}"
                    Click="OnCreateClick" Height="34" Padding="14,0" Margin="0,0,8,0"/>
            <Button x:Name="BtnAdd" Content="{loc:Loc AddToPlaylistBtnAdd}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="OnAddClick" Height="34" Padding="14,0" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc AddToPlaylistBtnCancel}" IsCancel="True"
                    Height="34" Padding="14,0"/>
        </StackPanel>
    </Grid>
</Window>
