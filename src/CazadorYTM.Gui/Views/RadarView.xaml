<UserControl x:Class="CazadorYTM.Gui.Views.RadarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
             xmlns:acc="clr-namespace:CazadorYTM.Gui.Accessibility"
             xmlns:models="clr-namespace:CazadorYTM.Core.Services;assembly=CazadorYTM.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="{loc:Loc RadarPanelName}"
             KeyboardNavigation.TabNavigation="Cycle">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Actions / Breadcrumbs & Section Selector -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Standard Category Selector (when not inspecting playlist details) -->
            <WrapPanel Grid.Column="0" VerticalAlignment="Center"
                       Visibility="{Binding IsViewingPlaylistDetails, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <RadioButton x:Name="RbHistory" Content="{loc:Loc RadarCatHistory}"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:RadarSection.History}}"
                             GroupName="RadarSec" Height="32" Margin="0,0,12,6" FontWeight="SemiBold"
                             PreviewKeyDown="Category_PreviewKeyDown"
                             AutomationProperties.Name="{loc:Loc RadarCatHistoryHint}"/>
                <RadioButton x:Name="RbLiked" Content="{loc:Loc RadarCatLiked}"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:RadarSection.LikedSongs}}"
                             GroupName="RadarSec" Height="32" Margin="0,0,12,6" FontWeight="SemiBold"
                             PreviewKeyDown="Category_PreviewKeyDown"
                             AutomationProperties.Name="{loc:Loc RadarCatLikedHint}"/>
                <RadioButton x:Name="RbPlaylists" Content="{loc:Loc RadarCatPlaylists}"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:RadarSection.Playlists}}"
                             GroupName="RadarSec" Height="32" Margin="0,0,12,6" FontWeight="SemiBold"
                             PreviewKeyDown="Category_PreviewKeyDown"
                             AutomationProperties.Name="{loc:Loc RadarCatPlaylistsHint}"/>
            </WrapPanel>

            <!-- Breadcrumb Navigation Bar (when inspecting playlist tracks) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsViewingPlaylistDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="{loc:Loc RadarBackToPlaylists}"
                        Command="{Binding BackToPlaylistsCommand}"
                        Height="32" Padding="12,0" Margin="0,0,12,0"
                        AutomationProperties.Name="{loc:Loc RadarBackToPlaylistsHint}"/>
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                           Text="{loc:Loc RadarPlaylistLabel}"/>
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,0"
                           Text="{Binding CurrentPlaylistTitle}"/>
            </StackPanel>

            <!-- Top Right Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc BtnRefresh}" Command="{Binding RefreshCurrentSectionCommand}"
                        Height="32" Padding="12,0" Margin="0,0,8,0"
                        AutomationProperties.Name="{loc:Loc RadarBtnRefreshHint}"/>
                <Button Content="{loc:Loc RadarBtnSession}" Command="{Binding OpenCookiesManagerCommand}"
                        Height="32" Padding="12,0"
                        AutomationProperties.Name="{loc:Loc RadarBtnSessionHint}"/>
            </StackPanel>
        </Grid>

        <!-- Search / Filter Box -->
        <Grid Grid.Row="1" Margin="0,0,0,12"
              Visibility="{Binding HasSessionConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtRadarFilter" Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}" 
                     Height="36" VerticalContentAlignment="Center"
                     ui:ControlHelper.PlaceholderText="{loc:Loc RadarFilterPlaceholder}"
                     AutomationProperties.Name="{loc:Loc RadarFilterHint}"/>
        </Grid>

        <!-- Center Content Area: DataGrid vs Session Prompt vs Error State -->
        <Grid Grid.Row="2">

            <!-- 1. Prompt when session is not connected -->
            <Border Visibility="{Binding HasSessionConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc RadarNoSessionTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{loc:Loc RadarNoSessionDesc}"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,20"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="{loc:Loc RadarBtnConnect}" Command="{Binding OpenCookiesManagerCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Height="38" Padding="20,0" Margin="0,0,10,8"
                                AutomationProperties.Name="{loc:Loc RadarBtnConnectHint}"/>
                        <Button Content="{loc:Loc BtnSupportTelegram}" Command="{Binding ContactSupportCommand}"
                                Height="38" Padding="16,0" Margin="0,0,0,8"
                                AutomationProperties.Name="{loc:Loc BtnSupportTelegramHint}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 2. Error Banner / Card when an error occurs -->
            <Border Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc RadarErrorTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,16"
                               AutomationProperties.Name="{Binding ErrorMessage}"
                               AutomationProperties.LiveSetting="Assertive"
                               acc:LiveRegion.Announce="{Binding ErrorMessage}"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="{loc:Loc RadarBtnRetry}" Command="{Binding RefreshCurrentSectionCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Height="34" Padding="16,0" Margin="0,0,8,6"/>
                        <Button Content="{loc:Loc RadarBtnManageCookies}" Command="{Binding OpenCookiesManagerCommand}"
                                Height="34" Padding="14,0" Margin="0,0,8,6"/>
                        <Button Content="{loc:Loc BtnExportLogs}" Command="{Binding ExportLogsCommand}"
                                Height="34" Padding="14,0" Margin="0,0,8,6"
                                AutomationProperties.Name="{loc:Loc BtnExportLogsHint}"/>
                        <Button Content="{loc:Loc RadarBtnSendSupport}" Command="{Binding ContactSupportCommand}"
                                Height="34" Padding="14,0" Margin="0,0,0,6"
                                AutomationProperties.Name="{loc:Loc RadarBtnSendSupportHint}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. Active Items DataGrid -->
                <DataGrid x:Name="GridRadar" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="48"
                      BorderThickness="1" BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}"
                      Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                      AutomationProperties.Name="{loc:Loc RadarGridHint}"
                      MouseDoubleClick="GridRadar_MouseDoubleClick"
                      PreviewKeyDown="GridRadar_PreviewKeyDown">

                <!-- Visibility only when connected and no blocking error -->
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSessionConnected}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>

                <!-- Accessible Context Menu -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc RadarMenuPlay}" InputGestureText="Enter" Command="{Binding PlayItemCommand}"/>
                        <MenuItem Header="{loc:Loc RadarMenuOpenPlaylist}" InputGestureText="Derecha"
                                  Command="{Binding OpenPlaylistCommand}"/>
                        <MenuItem Header="{loc:Loc RadarMenuSendDownload}" InputGestureText="Ctrl+D" Command="{Binding SendToDownloadCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc RadarBtnLike}" InputGestureText="Ctrl+Shift+L" Command="{Binding LikeSelectedCommand}"/>
                        <MenuItem Header="{loc:Loc RadarBtnDislike}" InputGestureText="Ctrl+Shift+D" Command="{Binding DislikeSelectedCommand}"/>
                        <MenuItem Header="{loc:Loc RadarBtnClearRating}" Command="{Binding ClearRatingCommand}"/>
                        <MenuItem Header="{loc:Loc RadarBtnAddToPlaylist}" InputGestureText="Ctrl+Shift+A" Command="{Binding AddToPlaylistCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc RadarMenuBack}" InputGestureText="Izquierda / Backspace"
                                  Command="{Binding BackToPlaylistsCommand}"/>
                        <MenuItem Header="{loc:Loc RadarMenuRefresh}" Command="{Binding RefreshCurrentSectionCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc MenuManageCookies}" Command="{Binding OpenCookiesManagerCommand}"/>
                        <MenuItem Header="{loc:Loc MenuExportLogs}" Command="{Binding ExportLogsCommand}"/>
                        <MenuItem Header="{loc:Loc MenuContactSupport}" Command="{Binding ContactSupportCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="56" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ThumbnailUrl}" Width="40" Height="40" Stretch="UniformToFill"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc ColTitle}" Binding="{Binding Title}" Width="*" MinWidth="250"/>
                    <DataGridTextColumn Header="{loc:Loc RadarColArtist}" Binding="{Binding Artist}" Width="200"/>
                    <DataGridTextColumn Header="{loc:Loc RadarColDuration}" Binding="{Binding DisplayDuration}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 4. Loading overlay -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}"
                    BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,0,0,10"/>
                    <TextBlock Text="{loc:Loc RadarLoading}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Action Bar / Status -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       AutomationProperties.Name="{Binding StatusText}"
                       AutomationProperties.LiveSetting="Polite"
                       acc:LiveRegion.Announce="{Binding StatusText}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Visibility="{Binding HasSessionConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="{loc:Loc RadarBtnOpenPlaylist}" Command="{Binding OpenPlaylistCommand}"
                        Height="34" Margin="0,0,8,0" Padding="14,0"
                        AutomationProperties.Name="{loc:Loc RadarBtnOpenPlaylistHint}"/>
                <Button Content="{loc:Loc BtnPlay}" Command="{Binding PlayItemCommand}"
                        Height="34" Margin="0,0,8,0" Padding="16,0"
                        AutomationProperties.Name="{loc:Loc RadarBtnPlayHint}"/>
                <Button Content="{loc:Loc RadarBtnLike}" Command="{Binding LikeSelectedCommand}"
                        Height="34" Margin="0,0,8,0" Padding="12,0"
                        AutomationProperties.Name="{loc:Loc RadarBtnLikeHint}"/>
                <Button Content="{loc:Loc RadarBtnDislike}" Command="{Binding DislikeSelectedCommand}"
                        Height="34" Margin="0,0,8,0" Padding="12,0"
                        AutomationProperties.Name="{loc:Loc RadarBtnDislikeHint}"/>
                <Button Content="{loc:Loc RadarBtnAddToPlaylist}" Command="{Binding AddToPlaylistCommand}"
                        Height="34" Margin="0,0,8,0" Padding="12,0"
                        AutomationProperties.Name="{loc:Loc RadarBtnAddToPlaylistHint}"/>
                <Button Content="{loc:Loc RadarBtnDownloadTrack}" Command="{Binding SendToDownloadCommand}"
                        Height="34" Padding="16,0"
                        AutomationProperties.Name="{loc:Loc RadarBtnDownloadTrackHint}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
