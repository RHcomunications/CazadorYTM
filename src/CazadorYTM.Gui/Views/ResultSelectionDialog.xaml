<Window x:Class="CazadorYTM.Gui.Views.ResultSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
        xmlns:acc="clr-namespace:CazadorYTM.Gui.Accessibility"
        Title="{Binding Title}"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        AutomationProperties.Name="{Binding Title}"
        AutomationProperties.HelpText="{loc:Loc ResultSelectionHelpText}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{Binding TypeDescription}" FontSize="13" 
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,12"/>

        <!-- List of Tracks with Direct Accessible CheckBoxes and UI Virtualization -->
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource SystemControlStrokeColorCardStrokeBrush}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" ClipToBounds="True">
            <ListBox x:Name="TracksList" ItemsSource="{Binding Tracks}" 
                     SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                     SelectionMode="Single"
                     KeyboardNavigation.TabNavigation="Once"
                     KeyboardNavigation.DirectionalNavigation="Cycle"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{loc:Loc ResultsListName}"
                     PreviewMouseRightButtonDown="TracksList_PreviewMouseRightButtonDown">
                <ListBox.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Loc RadarBtnLike}"
                                  Command="{Binding LikeTrackCommand}"
                                  CommandParameter="{Binding SelectedTrack}"/>
                        <MenuItem Header="{loc:Loc RadarBtnDislike}"
                                  Command="{Binding DislikeTrackCommand}"
                                  CommandParameter="{Binding SelectedTrack}"/>
                        <MenuItem Header="{loc:Loc RadarBtnClearRating}"
                                  Command="{Binding ClearTrackRatingCommand}"
                                  CommandParameter="{Binding SelectedTrack}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc RadarBtnAddToPlaylist}"
                                  Command="{Binding AddTrackToPlaylistCommand}"
                                  CommandParameter="{Binding SelectedTrack}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                  Focusable="True" IsTabStop="True"
                                  Padding="6,6" Margin="4,2"
                                  VerticalContentAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{Binding DisplayText}">
                            <TextBlock Text="{Binding DisplayText}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Selection Toolbar -->
        <Grid Grid.Row="3" Margin="0,12,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{loc:Loc SelectAll}" Command="{Binding SelectAllCommand}" Height="36" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="{loc:Loc DeselectAll}" Command="{Binding DeselectAllCommand}" Height="36" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="{loc:Loc ExportTxt}" Command="{Binding ExportTxtCommand}" Height="36" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="4" Text="{Binding SelectedCountText}" VerticalAlignment="Center" FontWeight="Medium" 
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       AutomationProperties.Name="{Binding SelectedCountText}"
                       AutomationProperties.LiveSetting="Polite"
                       acc:LiveRegion.Announce="{Binding SelectedCountText}"/>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc BtnAccept}" Style="{DynamicResource AccentButtonStyle}" 
                    Command="{Binding ConfirmCommand}" Width="130" Height="38" Margin="0,0,10,0"/>
            <Button Content="{loc:Loc BtnCancel}" IsCancel="True" Command="{Binding CancelCommand}" Width="110" Height="38"/>
        </StackPanel>
    </Grid>
</Window>
