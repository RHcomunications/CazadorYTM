<Window x:Class="CazadorYTM.Gui.Views.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:loc="clr-namespace:CazadorYTM.Gui.Markup"
        Title="{loc:Loc ScWindowTitle}"
        Width="700" Height="580"
        MinWidth="550" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{loc:Loc ScWindowName}"
        AutomationProperties.HelpText="{loc:Loc ScWindowHelpText}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc ScHeader}" FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{loc:Loc ScHeaderDesc}" 
                       FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <!-- List of Shortcuts -->
        <ListView x:Name="LstShortcuts" Grid.Row="1" 
                  SelectionMode="Single"
                  FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                  AutomationProperties.Name="{loc:Loc ScListName}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:Loc ScColShortcut}" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Shortcut}" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{loc:Loc ScColAction}" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="{loc:Loc ScBtnClose}" Width="150" Height="36" DockPanel.Dock="Right" 
                    IsDefault="True" IsCancel="True" Click="OnCloseClicked"
                    AutomationProperties.Name="{loc:Loc ScBtnCloseHint}"/>
        </DockPanel>
    </Grid>
</Window>
